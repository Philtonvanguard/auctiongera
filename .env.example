# Copy to .env for local work. Never commit the filled-in version.

# ── Flask (auction engine) ───────────────────────────────────────────────────
# Production uses Render's managed Postgres (internal host, dpg-...).
# Omit entirely to fall back to local SQLite for development.
DATABASE_URL=postgresql://user:password@host/dbname

# Required in production. Generate with: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

# Source of truth for the admin login: creates the admin if missing, resets the
# password if it already exists. Change it here and redeploy to rotate.
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@auctiongera.com

# n8n webhooks (email notifications)
N8N_BID_WEBHOOK=https://myauction.duckdns.org/webhook/new-bid
N8N_PAYMENT_WEBHOOK=https://myauction.duckdns.org/webhook/auction-payment

# Tawk.to chat. The widget only renders when both are set.
TAWK_PROPERTY_ID=
TAWK_WIDGET_ID=

# ── Marketing site (Cloudflare Pages) ────────────────────────────────────────
# Build-time: where to read /api/lots when baking lots into the static HTML.
# Local dev default is http://127.0.0.1:5000
AUCTION_API_URL=http://127.0.0.1:5000

# Runtime: origin the Pages proxy forwards /auction, /login, /admin etc. to.
# Set this in the Cloudflare Pages project, not here.
FLASK_ORIGIN=https://auctiongera.onrender.com

# Public origin, no trailing slash. Drives canonical URLs, OG tags, sitemap.
SITE_URL=https://auctiongera.bid

# Contact form destination. Needs a new n8n workflow; the other two will not fit.
N8N_CONTACT_WEBHOOK=
